# Nepal Flood Map — Environment Variables (EXAMPLE)
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored — never commit it.
# Generated by Hermes Agent (Nous Research)

# ── Optional: Free LLM Alternatives (OpenAI-compatible) ──────────────────────
# The app tries these in order for news summarization fallback.
# Get ONE of these free keys — all have generous free tiers.
# ──────────────────────────────────────────────────────────────────────────────

# NVIDIA NIM (Recommended — generous free tier)
# Get at: https://build.nvidia.com/explore/discover
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq (14,400 req/day free)
# Get at: https://console.groq.com
GROQ_API_KEY=

# Together AI ($1 free credit)
# Get at: https://api.together.xyz
TOGETHER_API_KEY=

# OpenRouter (free models available)
# Get at: https://openrouter.ai
OPENROUTER_API_KEY=

# Google Gemini (1,500 req/day free per key, generous free tier)
# Get at: https://aistudio.google.com/apikey
# Configure up to 7 keys for automatic fallback when rate limits are hit
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=

# ── Optional: News Aggregation APIs ──────────────────────────────────────────
# NewsAPI.org (100 req/day free on localhost, paid for production)
# Get at: https://newsapi.org/register
NEWS_API_KEY=

# Google Custom Search (100 req/day free per key)
# Get API key: https://console.cloud.google.com/apis/credentials
# Get Search Engine ID (CX): https://programmablesearchengine.google.com/
# Configure up to 7 keys for automatic fallback when rate limits are hit
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
GOOGLE_API_KEY4=
GOOGLE_API_KEY5=
GOOGLE_API_KEY6=
GOOGLE_API_KEY7=
GOOGLE_CX=

# ── Optional: Anthropic (fallback if free LLMs fail) ─────────────────────────
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Optional: Mapbox (interactive map) ──────────────────────────────────────
# Get at: https://account.mapbox.com/access-tokens/
# If left empty, the app falls back to Leaflet + OpenStreetMap (free, no key)
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Optional: NASA FIRMS satellite imagery ──────────────────────────────────
# Free registration at: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# ── Required for Vercel cron auth ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Required for cron self-call on deploy ───────────────────────────────────
# Set to your production URL (e.g., https://your-app.vercel.app)
NEXT_PUBLIC_BASE_URL=